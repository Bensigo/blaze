# Local development works without a hosted database. Never commit actual keys.
NEXT_PUBLIC_LOCAL_DEV=true
# DATABASE_URL=postgresql://... (new product database only)
# CREDENTIAL_KEY=32_random_bytes_encoded_as_base64
# GOOGLE_CLIENT_ID=your_google_oauth_app
# GOOGLE_CLIENT_SECRET=your_google_oauth_secret
# APP_URL=https://your-production-domain
WORKER_TOKEN=replace_with_a_random_service_secret
CRON_SECRET=replace_with_a_different_random_secret
PUBLISHING_ENABLED=false
# Worker only. Keep its token out of game pages.
# ALLOW_LOCAL_FIXTURE=true
# BLOB_CLIENT_UPLOAD=true
# BLOB_READ_WRITE_TOKEN=deployment_private_blob_token
# TIKTOK_PUBLIC_POSTING_APPROVED=true only after actual application audit
