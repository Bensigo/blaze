# Local PGlite development works without hosted credentials.
NEXT_PUBLIC_LOCAL_DEV=true
DATABASE_STORAGE_LIMIT_BYTES=1073741824
# Production PostgreSQL (pooled connection); run npm run db:migrate before serving traffic.
# DATABASE_URL=postgresql://user:password@database.example/db?sslmode=verify-full
# CREDENTIAL_KEY=32_random_bytes_encoded_as_base64
# Configure Google OAuth in your own Neon Managed Better Auth service.
# NEON_AUTH_BASE_URL=https://YOUR_BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth
# NEON_AUTH_COOKIE_SECRET=at_least_32_random_characters
# NEON_AUTH_GOOGLE_CONFIGURED=true
# APP_URL=https://your-blaze.example
# Authenticated retention-cleanup endpoint for non-Netlify schedulers; generate a unique secret.
# CRON_SECRET=
# Optional private player canvas capture storage. Never expose these in game code.
# NEON_STORAGE_ENDPOINT=https://YOUR_BRANCH.storage.REGION.aws.neon.tech
# NEON_STORAGE_REGION=eu-central-1
# NEON_STORAGE_ACCESS_KEY_ID=
# NEON_STORAGE_SECRET_ACCESS_KEY=
# NEON_STORAGE_BUCKET=blaze-media
# Or private Vercel Blob storage:
# BLOB_READ_WRITE_TOKEN=
# Optional internal Forever integration; exact server-owned workspace binding required.
# FOREVER_OBSERVABILITY_WORKSPACE_ID=
# FOREVER_OBSERVABILITY_TOKEN=
