# Local development works without a hosted database. Never commit actual keys.
NEXT_PUBLIC_LOCAL_DEV=true
# DATABASE_URL=postgresql://... (pooled Neon database connection)
DATABASE_STORAGE_LIMIT_BYTES=1073741824
# CREDENTIAL_KEY=32_random_bytes_encoded_as_base64
# NEON_AUTH_BASE_URL=https://YOUR_BRANCH.neonauth.REGION.aws.neon.tech/neondb/auth
# NEON_AUTH_COOKIE_SECRET=at_least_32_random_characters
# NEON_AUTH_GOOGLE_CONFIGURED=true only after the owner's Google OAuth client is configured in Neon
# APP_URL=https://your-production-domain
# Configure the owner's Google client ID/secret in Neon Managed Better Auth, not in this app.
# Before production deployment: npm run db:migrate
WORKER_TOKEN=replace_with_a_random_service_secret
CRON_SECRET=replace_with_a_different_random_secret
PUBLISHING_ENABLED=false
# Content production and its independent monitor remain default-off.
# Configure reviewed provider/game records and an authenticated one-minute watchdog trigger before enabling.
BLAZE_CLOUD_PRODUCTION_ENABLED=false
# A separate, single-use operator pilot grant is required; this never verifies normal production.
BLAZE_CLOUD_PILOT_ENABLED=false
BLAZE_JEV_SCRIPT_REVIEW_ENABLED=false
# BLAZE_CLOUD_PILOT_OPERATOR_ID=exact_authenticated_owner_id
# BLAZE_CLOUD_PILOT_WORKSPACE_ID=exact_owner_workspace_id
# BLAZE_CLOUD_PILOT_GAME_ID=exact_approved_pilot_game_id
BLAZE_CLOUD_PILOT_MAX_LIST_COST_CENTS=100
BLAZE_DAILY_IDEAS_ENABLED=false
# Legacy research/maintenance dispatch is also paused; release must not restart metered jobs.
BLAZE_LEGACY_DAILY_ENABLED=false
BLAZE_CLOUD_WATCHDOG_ENABLED=false
# Native adapter remains outside deployed functions until separate schedule approval.
BLAZE_CLOUD_WATCHDOG_SCHEDULE_ENABLED=false
# BLAZE_CLOUD_WATCHDOG_WORKSPACE_ID=exact_owner_workspace_id
# Worker only. Keep its token out of game pages.
# ALLOW_LOCAL_FIXTURE=true
# BLOB_CLIENT_UPLOAD=true
# BLOB_READ_WRITE_TOKEN=deployment_private_blob_token
# Neon private S3 server configuration. Never use the administrative NEON_API_KEY here.
# NEON_STORAGE_ENDPOINT=https://YOUR_BRANCH.storage.REGION.aws.neon.tech
# NEON_STORAGE_REGION=eu-central-1
# NEON_STORAGE_ACCESS_KEY_ID=branch_storage_key_id
# NEON_STORAGE_SECRET_ACCESS_KEY=branch_storage_secret
# NEON_STORAGE_BUCKET=blaze-media
# Worker only: NEON_CLIENT_UPLOAD=true uploads directly via scoped staging URLs.
# TIKTOK_PUBLIC_POSTING_APPROVED=true only after actual application audit
